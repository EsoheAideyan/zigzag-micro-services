# Production / deployment env template.
# Copy to .env or .env.production on the server and fill with real values.
# Do not commit .env or .env.production.

# --- API Gateway & auth (use strong random values in production) ---
JWT_SECRET_ACCESS_TOKEN=
JWT_SECRET_REFRESH_TOKEN=
INTERNAL_GATEWAY_KEY=

# --- RabbitMQ (used by events-service and notification-service) ---
RABBITMQ_USER=zigzag
RABBITMQ_PASSWORD=

# --- MinIO public URL (optional: base URL for media links, e.g. https://minio.yourdomain.com) ---
# MINIO_PUBLIC_URL=http://localhost:9000
